/ {
	model = "Digi International ConnectCore 6 QuadPlus Single Board Computer.";
	compatible = "digi,ccimx6qpsbc", "digi,ccimx6sbc", "digi,ccimx6qp", "digi,ccimx6", "fsl,imx6qp";
	digi,machine,name = "ccimx6qpsbc";

	aliases {
		mxcfb0 = &mxcfb1;
		mxcfb1 = &mxcfb2;
		i2c3 = &sc18is600;
	};

	5v_reg {
		compatible = "regulator-fixed";
		gpio = <&gpio_extender 7 0>;
		regulator-name = "gpio-ext-reg";
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	chosen {
		stdout-path = &uart4;
	};

	mxcfb1: fb@0 {
		compatible = "fsl,mxc_sdc_fb";
		disp_dev = "lcd";
		interface_pix_fmt = "RGB24";
		mode_str ="FORTEC";
		default_bpp = <32>;
		int_clk = <0>;
		late_init = <0>;
		status = "disabled";
	};

	mxcfb2: fb@1 {
		compatible = "fsl,mxc_sdc_fb";
		disp_dev = "hdmi";
		interface_pix_fmt = "RGB24";
		mode_str ="1920x1080M@60";
		default_bpp = <32>;
		int_clk = <0>;
		late_init = <0>;
		status = "disabled";
	};



	/* Parallel display */
	lcd: display@di0 {
		compatible = "fsl,lcd";
		ipu_id = <0>;
		disp_id = <0>;
		default_ifmt = "RGB24";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ipu1_di0>;
		status = "disabled";
	};

        /* TODO(Ks): remove if pmic pwm is working */
	lcd_backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2 0 10000>;
		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <6>;
		status = "diabled";
	};

	/* SGTL5000 codec is powered by 3V3 BUCK_PERI, but controlled
	 * by GPIO2_25 via a FET transistor
	 */
	codec_power: fixedregulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "aud_pwr_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 25 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&bperi>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_aud_pwr_en>;
		status = "disabled";
		regulator-state-mem {
			regulator-off-in-suspend;
		};
		regulator-state-disk {
			regulator-off-in-suspend;
		};
	};


	sound_sgtl5000: sound-sgtl5000 {
		compatible = "fsl,imx-audio-sgtl5000";
		model = "sgtl5000-audio";
		cpu-dai = <&ssi2>;
		audio-codec = <&sgtl5000>;
		audio-routing =
			"MIC_IN", "Mic Jack",
			"Mic Jack", "Mic Bias",
			"Headphone Jack", "HP_OUT";
		mux-int-port = <2>;
		mux-ext-port = <3>;
		hp-det-debounce = <250>;
		status = "disabled";
	};


	/* for now no sound on the hdmi interface
	sound_hdmi: sound-hdmi {
		compatible = "fsl,imx6q-audio-hdmi",
			     "fsl,imx-audio-hdmi";
		model = "imx-audio-hdmi";
		hdmi-controller = <&hdmi_audio>;
		status = "disabled";
	};
	*/

	v4l2_cap_0: v4l2-cap@0 {
		compatible = "fsl,imx6q-v4l2-capture";
		mclk_source = <0>;
		ipu_id = <0>;
		csi_id = <0>;
		status = "disabled";
	};

	v4l2_cap_1: v4l2-cap@1 {
		compatible = "fsl,imx6q-v4l2-capture";
		mclk_source = <0>;
		ipu_id = <1>;
		csi_id = <1>;
		status = "disabled";
	};

	v4l2_out: v4l2-out {
		compatible = "fsl,mxc_v4l2_output";
		status = "disabled";
	};

 	/* ON_HOLD signal */
	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio6 16  GPIO_ACTIVE_LOW>;
	};
};

&audmux {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_audmux>;
};

&ecspi1 {
	fsl,spi-num-chipselects = <1>;
	cs-gpios = <&gpio2 30 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi1>;
	status = "disabled";

        sc18is600: i2c@0 {
                compatible = "nxp,sc18is600";
                spi-max-frequency = <700000>; /* 700KHz */
                spi-cpol;
                spi-cpha;
                reg = <0>;

                interrupt-parent = <&gpio2>;
                interrupts = <23 IRQ_TYPE_EDGE_FALLING>;

                reset-gpios = <&gpio3 22 GPIO_ACTIVE_LOW>;

                clock-frequency = <100000>; /* 100KHz */

                #address-cells = <0x1>;
                #size-cells = <0x0>;
        };
};

&ecspi2 {
	fsl,spi-num-chipselects = <1>;
    cs-gpios = <&gpio5 29 GPIO_ACTIVE_HIGH>; // CSI0_DAT11  4*32 + 29 -> 157
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2>;
	status = "disabled";
};

/* 10/100/1000 KSZ9031 PHY */
&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet>;
	phy-mode = "rgmii";
	phy-reset-gpios = <&gpio1 25 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <10>;
	phy-reset-wait = <1>;
	phy-supply = <&ldo4>;
	fsl,magic-packet;
};

&gpc {
	fsl,cpu_pupscr_sw2iso = <0xf>;
	fsl,cpu_pupscr_sw = <0xf>;
	fsl,cpu_pdnscr_iso2sw = <0x1>;
	fsl,cpu_pdnscr_iso = <0x1>;
	fsl,ldo-bypass = <0>; /* No ldo-bypass */
	fsl,wdog-reset = <1>; /* watchdog select of reset source */
	pu-supply = <&reg_pu>;
};

&hdmi_cec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hdmi_cec>;
};

&hdmi_core {
	ipu_id = <1>;
	disp_id = <1>;
};

&hdmi_video {
	fsl,phy_reg_vlev = <0x0294>;
	fsl,phy_reg_cksymtx = <0x800d>;
	digi,dvi_mode;
};


&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
};

&i2c2 {
	pmic_dialog: dialog@58 {
		leds {
			compatible = "dlg,da9063-leds";

			lvds0-backlight@0xc6 {
				dlg,led-gpio-reg = <0x1a 0xf0>;
				dlg,led-reg = <0xc6>;
				/*
				 * If using the latest Video Adapter Board
				 * uncomment to invert the backlight polarity
				 */
				dlg,inverse-polarity;
				linux,default-trigger = "backlight";
			};

			lvds1-backlight@0xc6 {
				dlg,led-gpio-reg = <0x1c 0xf0>;
				dlg,led-reg = <0xc8>;
				/*
				 * If using the latest Video Adapter Board
				 * uncomment to invert the backlight polarity
				 */
				//dlg,inverse-polarity;
				linux,default-trigger = "backlight";
			};
		};
	};
};

&i2c3 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c3>;

	edid@50 {
		compatible = "fsl,imx6-hdmi-i2c";
		reg = <0x50>;
		status = "disabled";
	};

        ili251x: ili251x@41 {
		compatible = "ilitek,ili251x";
		reg = <0x41>;
		interrupt-parent = <&gpio2>;
		interrupts = <28 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio4 20 GPIO_ACTIVE_HIGH>;
	};


	gemmi_cam_bridge_0: gemmi_cam_bridge@04 {
		compatible = "ovti,gemmi_cam_bridge";
		reg = <0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ipu1_1>;
		clocks = <&clks 201>;
		clock-names = "csi_mclk";
		csi_id = <0>;
		ipu_id = <0>;
		mclk = <24000000>;
		mclk_source = <0>;
		digi,defer-probe;
		status = "disabled";
	};

	gemmi_cam_bridge_1: gemmi_cam_bridge@06 {
		compatible = "ovti,gemmi_cam_bridge";
		reg = <0x06>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ipu2_2>;
		clocks = <&clks 201>;
		clock-names = "csi_mclk";
		csi_id = <1>;
		ipu_id = <1>;
		mclk = <24000000>;
		mclk_source = <0>;
		digi,defer-probe;
		status = "disabled";
	};

        tc358768: tc358768@0e {
		compatible = "toshiba,tc358768";
		reg = <0x0e>;
		data-lines = <24>;
		lanes = <4>;
		reset = <&gpio7 13 1>;
	};


	sgtl5000: codec@0a {
		compatible = "fsl,sgtl5000";
		reg = <0x0a>;
		clock-frequency = <24000000>;
		clocks = <&clks 201>;
		VDDA-supply = <&codec_power>;
		VDDIO-supply = <&codec_power>;
		status = "disabled";
	};

	MAX1726x: MAX1726x@36 {
		status              = "okay";
		reg                 = <0x36>; // MINIQUSB I2C ADDR=1, SIZE=0

		interrupt-parent    = <&gpio2>;
		interrupts 	    = <5 IRQ_TYPE_EDGE_FALLING>;
	};

	bq25895: bq25895@6a {
		compatible = "ti,bq25895";
		reg = <0x6a>;

		ti,battery-regulation-voltage = <4200000>;
		ti,charge-current = <1500000>;
		ti,termination-current = <50000>;
		ti,precharge-current = <128000>;
		ti,minimum-sys-voltage = <3600000>;
		ti,boost-voltage = <5510000>;
		ti,boost-max-current = <2400000>;

		ti,use-ilim-pin;
		ti,thermal-regulation-threshold = <120>;

		interrupt-parent    = <&gpio2>;
		interrupts 	    = <7 IRQ_TYPE_EDGE_FALLING>;
	};
};


&MAX1726x {
    compatible  = "maxim,MAX1726x";

    rsense          = <10>;     /* miliOhm */
    model-option    = <1>;      /* 1: EZ Model, 2: Custom INI without model table
                                    3: Custom INI with custom model table */

    talrt-min   = <0>;          /* DegreeC */
    talrt-max   = <50>;         /* DegreeC */
    valrt-min   = <3000>;       /* mV */
    valrt-max   = <4500>;       /* mV */
    salrt-min   = <1>;          /* Percent */
    salrt-max   = <99>;         /* Percent */
    ialrt-min   = <(-5000)>;    /* mA */
    ialrt-max   = <5000>;       /* mA */


    /*** INI parameters ***/
    /* Option 1/2/3 */
    designcap   = /bits/ 16 <0x0BB8>; /* 1500 mAh */
    ichgterm    = /bits/ 16 <0x0640>;
    vempty      = /bits/ 16 <0xA561>; /* 3300 mV */
    vcharge     = <4300>; /* mV */

    /* Option 2/3 */
    learncfg    = /bits/ 16 <0xC482>;
    rcomp0      = /bits/ 16 <0x0070>;
    tempco      = /bits/ 16 <0x223E>;
    qrtable00   = /bits/ 16 <0x1050>;
    qrtable10   = /bits/ 16 <0x2013>;
    qrtable20   = /bits/ 16 <0x0B04>;
    qrtable30   = /bits/ 16 <0x0885>;

    /* Option 2 */
    dpacc       = /bits/ 16 <0x0C80>;
    modelcfg    = /bits/ 16 <0x8000>;

    /* Option 3 */
    relaxcfg    = /bits/ 16 <0x2039>;
    config      = /bits/ 16 <0x2210>;
    config2     = /bits/ 16 <0x0658>;
    fullsocthr  = /bits/ 16 <0x5F05>;
    tgain       = /bits/ 16 <0xEE56>;
    toff        = /bits/ 16 <0x1DA4>;
    curve       = /bits/ 16 <0x0025>;
    model-data  = /bits/ 16 <
        /* OCV Table */
        0x9760 0xa510 0xb100 0xb600 0xb7a0 0xb900 0xba70 0xbc70
        0xbde0 0xbfc0 0xc250 0xc510 0xc990 0xcea0 0xd040 0xd750
        /* X Table */
        0x0060 0x0120 0x0240 0x0d80 0x08b0 0x0590 0x1200 0x3210
        0x0ee0 0x0a40 0x0950 0x08e0 0x0800 0x0780 0x06b0 0x06b0
        /* RCompSeg Table */
        0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100
        0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100
    >;
};
/* TODO(Ks) remove if pmic pwm is working */
&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm2>;
	status = "disabled";
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	audmux {
		pinctrl_audmux: audmux {
			fsl,pins = <
				MX6QDL_PAD_CSI0_DAT7__AUD3_RXD  0x130b0
				MX6QDL_PAD_CSI0_DAT4__AUD3_TXC  0x130b0
				MX6QDL_PAD_CSI0_DAT5__AUD3_TXD  0x110b0
				MX6QDL_PAD_CSI0_DAT6__AUD3_TXFS 0x130b0
			>;
		};
	};

	aud_pwr_en {
		pinctrl_aud_pwr_en: aud_pwr_en {
			fsl,pins = <

				MX6QDL_PAD_EIM_OE__GPIO2_IO25 0x80000000
			>;
		};
	};

	ecspi1 {
		pinctrl_ecspi1: ecspi1 {
			fsl,pins = <
				MX6QDL_PAD_EIM_D17__ECSPI1_MISO 0x100b1
				MX6QDL_PAD_EIM_D18__ECSPI1_MOSI 0x100b1
				MX6QDL_PAD_EIM_D16__ECSPI1_SCLK 0x100b1
				MX6QDL_PAD_EIM_EB2__GPIO2_IO30  0x100b1
				MX6QDL_PAD_KEY_COL2__GPIO4_IO10 0x100b1
				MX6QDL_PAD_EIM_CS0__GPIO2_IO23  0x100b1
			>;
		};
	};

	ecspi2 {
			pinctrl_ecspi2: ecspi2 {
			fsl,pins = <
				MX6QDL_PAD_CSI0_DAT8__ECSPI2_SCLK   0x100b1
				MX6QDL_PAD_CSI0_DAT9__ECSPI2_MOSI   0x100b1
				MX6QDL_PAD_CSI0_DAT10__ECSPI2_MISO  0x100b1
			>;
		};
	};

	enet {
		pinctrl_enet: enet {
			fsl,pins = <
				MX6QDL_PAD_ENET_MDIO__ENET_MDIO       0x1b0b0
				MX6QDL_PAD_ENET_MDC__ENET_MDC         0x1b0b0
				MX6QDL_PAD_RGMII_TXC__RGMII_TXC       0x1b0b0
				MX6QDL_PAD_RGMII_TD0__RGMII_TD0       0x1b0b0
				MX6QDL_PAD_RGMII_TD1__RGMII_TD1       0x1b0b0
				MX6QDL_PAD_RGMII_TD2__RGMII_TD2       0x1b0b0
				MX6QDL_PAD_RGMII_TD3__RGMII_TD3       0x1b0b0
				MX6QDL_PAD_RGMII_TX_CTL__RGMII_TX_CTL 0x1b0b0
				MX6QDL_PAD_ENET_REF_CLK__ENET_TX_CLK  0x1b0b0
				MX6QDL_PAD_RGMII_RXC__RGMII_RXC       0x1b0b0
				MX6QDL_PAD_RGMII_RD0__RGMII_RD0       0x1b0b0
				MX6QDL_PAD_RGMII_RD1__RGMII_RD1       0x1b0b0
				MX6QDL_PAD_RGMII_RD2__RGMII_RD2       0x1b0b0
				MX6QDL_PAD_RGMII_RD3__RGMII_RD3       0x1b0b0
				MX6QDL_PAD_RGMII_RX_CTL__RGMII_RX_CTL 0x1b0b0
				MX6QDL_PAD_ENET_REF_CLK__ENET_TX_CLK  0x1b0b0
				MX6QDL_PAD_ENET_TX_EN__GPIO1_IO28     0x1b0b0
				MX6QDL_PAD_ENET_CRS_DV__GPIO1_IO25    0x1b0b0
			>;
		};
	};

	hdmi_cec {
		pinctrl_hdmi_cec: hdmicec {
			fsl,pins = <
				MX6QDL_PAD_KEY_ROW2__HDMI_TX_CEC_LINE 0x1f8b0
			>;
		};
	};

	i2c1 {
		pinctrl_i2c1: i2c1 {
			fsl,pins = <
				MX6QDL_PAD_EIM_D21__I2C1_SCL 0x4001b8b1
				MX6QDL_PAD_EIM_D28__I2C1_SDA 0x4001b8b1
			>;
		};
	};

	i2c2 {
		pinctrl_i2c2: i2c2 {
			fsl,pins = <
				MX6QDL_PAD_KEY_COL3__I2C2_SCL 0x4001b8b1
				MX6QDL_PAD_KEY_ROW3__I2C2_SDA 0x4001b8b1
			>;
		};
	};

	i2c3 {
		pinctrl_i2c3: i2c3 {
			fsl,pins = <
				MX6QDL_PAD_GPIO_3__I2C3_SCL 0x4001b8b1
				MX6QDL_PAD_GPIO_16__I2C3_SDA 0x4001b8b1
			>;
		};
	};

	ipu1 {
		pinctrl_ipu1_1: ipu1grp-1 { /* parallel camera */
			fsl,pins = <
				MX6QDL_PAD_CSI0_DAT12__IPU1_CSI0_DATA12    0x80000000
				MX6QDL_PAD_CSI0_DAT13__IPU1_CSI0_DATA13    0x80000000
				MX6QDL_PAD_CSI0_DAT14__IPU1_CSI0_DATA14    0x80000000
				MX6QDL_PAD_CSI0_DAT15__IPU1_CSI0_DATA15    0x80000000
				MX6QDL_PAD_CSI0_DAT16__IPU1_CSI0_DATA16    0x80000000
				MX6QDL_PAD_CSI0_DAT17__IPU1_CSI0_DATA17    0x80000000
				MX6QDL_PAD_CSI0_DAT18__IPU1_CSI0_DATA18    0x80000000
				MX6QDL_PAD_CSI0_DAT19__IPU1_CSI0_DATA19    0x80000000
				MX6QDL_PAD_CSI0_PIXCLK__IPU1_CSI0_PIXCLK   0x0000a0b0
				MX6QDL_PAD_CSI0_MCLK__IPU1_CSI0_HSYNC      0x80000000
				MX6QDL_PAD_CSI0_VSYNC__IPU1_CSI0_VSYNC     0x80000000
				MX6QDL_PAD_EIM_WAIT__GPIO5_IO00            0x80000000
				MX6QDL_PAD_CSI0_DATA_EN__GPIO5_IO20	   0x80000000
			>;
		};

		/* Parallel display */
		pinctrl_ipu1_di0: ipu1grp-2 {
			fsl,pins = <
				/* DISP0_CLK */
				MX6QDL_PAD_DI0_DISP_CLK__IPU1_DI0_DISP_CLK 0xa0
				/* DISP0_DRDY */
				MX6QDL_PAD_DI0_PIN15__IPU1_DI0_PIN15       0xa0
				/* DISP0 VSYNC */
				MX6QDL_PAD_DI0_PIN3__IPU1_DI0_PIN03        0xa0
				/* DISP0 HSYNC */
				MX6QDL_PAD_DI0_PIN2__IPU1_DI0_PIN02        0xa0
				/* Data bus */
				MX6QDL_PAD_DISP0_DAT0__IPU1_DISP0_DATA00   0xa0
				MX6QDL_PAD_DISP0_DAT1__IPU1_DISP0_DATA01   0xa0
				MX6QDL_PAD_DISP0_DAT2__IPU1_DISP0_DATA02   0xa0
				MX6QDL_PAD_DISP0_DAT3__IPU1_DISP0_DATA03   0xa0
				MX6QDL_PAD_DISP0_DAT4__IPU1_DISP0_DATA04   0xa0
				MX6QDL_PAD_DISP0_DAT5__IPU1_DISP0_DATA05   0xa0
				MX6QDL_PAD_DISP0_DAT6__IPU1_DISP0_DATA06   0xa0
				MX6QDL_PAD_DISP0_DAT7__IPU1_DISP0_DATA07   0xa0
				MX6QDL_PAD_DISP0_DAT8__IPU1_DISP0_DATA08   0xa0
				MX6QDL_PAD_DISP0_DAT9__IPU1_DISP0_DATA09   0xa0
				MX6QDL_PAD_DISP0_DAT10__IPU1_DISP0_DATA10  0xa0
				MX6QDL_PAD_DISP0_DAT11__IPU1_DISP0_DATA11  0xa0
				MX6QDL_PAD_DISP0_DAT12__IPU1_DISP0_DATA12  0xa0
				MX6QDL_PAD_DISP0_DAT13__IPU1_DISP0_DATA13  0xa0
				MX6QDL_PAD_DISP0_DAT14__IPU1_DISP0_DATA14  0xa0
				MX6QDL_PAD_DISP0_DAT15__IPU1_DISP0_DATA15  0xa0
				MX6QDL_PAD_DISP0_DAT16__IPU1_DISP0_DATA16  0xa0
				MX6QDL_PAD_DISP0_DAT17__IPU1_DISP0_DATA17  0xa0
				MX6QDL_PAD_DISP0_DAT18__IPU1_DISP0_DATA18  0xa0
				MX6QDL_PAD_DISP0_DAT19__IPU1_DISP0_DATA19  0xa0
				MX6QDL_PAD_DISP0_DAT20__IPU1_DISP0_DATA20  0xa0
				MX6QDL_PAD_DISP0_DAT21__IPU1_DISP0_DATA21  0xa0
				MX6QDL_PAD_DISP0_DAT22__IPU1_DISP0_DATA22  0xa0
				MX6QDL_PAD_DISP0_DAT23__IPU1_DISP0_DATA23  0xa0
			>;
		};
	};

	ipu2 {
		pinctrl_ipu2: ipu2 {
			fsl,pins = <
				/* Display IRQ */
				MX6QDL_PAD_NANDF_D1__GPIO2_IO01            0x80000000
				/* Display contrast */
				MX6QDL_PAD_DI0_PIN4__GPIO4_IO20            0x80000000
				MX6QDL_PAD_DI0_DISP_CLK__IPU2_DI0_DISP_CLK 0x38
				MX6QDL_PAD_DI0_PIN15__IPU2_DI0_PIN15       0x10
